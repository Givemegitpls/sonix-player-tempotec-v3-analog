#!/bin/sh
#
# Keeps adb reachable when it was asked for, and only then.
#
# On this firmware adb is a USB mode of the legacy android gadget, and the thing
# that selects it is the player: the stock firmware has no script that starts
# adb at boot at all (its K90adb runs at shutdown), so with a player that never
# starts there is no adb, and with no adb there is nothing to look at -- the
# device shows its boot logo and stops, which is exactly what a firmware that
# hangs looks like. That happened once here and cost a flash to find out.
#
# The answer is not to have adb on before anyone asked: a device that answers on
# the USB port by default is a device anyone can walk up to. So this script asks
# first, and two things count as asking:
#
#   [system] adb = 1 in /data/device_config.ini -- the Developer options switch;
#   /mnt/sd_0/enable_adb on the card -- the way back in when the player does not
#                                        start and the switch cannot be reached.
#
# With neither, the gadget is left alone: the player builds it and owns its mode
# (DAC, storage, whatever the interface asked for). With either, and while
# neither sonix_player nor sonix_launch is running, the gadget is set to adb and
# adbd started. While the player runs it owns the port, and this loop keeps out
# of its way.
#
# /mnt/sd_0/disable_adb overrides both and keeps adb off for one session.
#
# Report: /mnt/sd_0/adb_boot.log; adbd's own output: /mnt/sd_0/adbd.log.

GADGET=/sys/class/android_usb/android0
CONFIG=/data/device_config.ini
FORCE=/mnt/sd_0/enable_adb
STOP=/mnt/sd_0/disable_adb
LOG=/mnt/sd_0/adb_boot.log
PERIOD=8

log() { echo "$(date '+%H:%M:%S') $*" >> "$LOG" 2>/dev/null; }

adbd_pid() {
	for p in /proc/[0-9]*; do
		if [ "$(cat "$p/comm" 2>/dev/null)" = "adbd" ]; then
			echo "${p#/proc/}"
			return 0
		fi
	done
	return 1
}

player_running() {
	pidof sonix_player > /dev/null 2>&1 && return 0
	pidof sonix_launch > /dev/null 2>&1 && return 0
	return 1
}

# The [system] adb row of the player's own settings file, "0" when it says
# nothing: a missing file, a missing section, a missing row all mean the same
# thing -- nobody asked.
config_adb() {
	[ -f "$CONFIG" ] || { echo 0; return; }
	value=$(awk -F= '
		/^\[/ { section = ($0 ~ /^\[system\]/); next }
		section && $1 ~ /^[ \t]*adb[ \t]*$/ { gsub(/[ \t\r]/, "", $2); value = $2 }
		END { print (value == "" ? 0 : value) }
	' "$CONFIG" 2>/dev/null)
	[ -n "$value" ] || value=0
	echo "$value"
}

adb_wanted() {
	[ -f "$STOP" ] && return 1
	[ -f "$FORCE" ] && return 0
	[ "$(config_adb)" = "1" ] && return 0
	return 1
}

# The order matters: the gadget has to be disabled before its functions are
# rewritten, and enabled after.
set_adb_mode() {
	echo 0 > "$GADGET/enable" 2>/dev/null
	sleep 1
	echo 18d1 > "$GADGET/idVendor" 2>/dev/null
	echo 0d02 > "$GADGET/idProduct" 2>/dev/null
	echo adb > "$GADGET/functions" 2>/dev/null
	echo 1 > "$GADGET/enable" 2>/dev/null
	sleep 2
	[ "$(cat "$GADGET/functions" 2>/dev/null)" = "adb" ]
}

start_adbd() {
	adbd_pid > /dev/null && return 0
	/sbin/adbd >> /mnt/sd_0/adbd.log 2>&1 &
	sleep 1
	log "adbd started, pid $(adbd_pid)"
}

watchdog() {
	log "--- boot: player=$(pidof sonix_player) functions=$(cat $GADGET/functions 2>/dev/null) config_adb=$(config_adb) enable_adb=$([ -f "$FORCE" ] && echo yes || echo no)"

	if ! adb_wanted; then
		log "adb not asked for: the gadget is left to the player"
	else
		# adb first, before the player is the only thing that can bring it up.
		#
		# The player's own ADB switch builds a configfs gadget, and this kernel
		# refuses configfs functions: the switch goes on and nothing appears. So
		# adb is set here, once, through the firmware's legacy gadget -- the same
		# nodes the stock firmware's own adb script writes. From this point on the
		# mode belongs to the player: if the interface asks for DAC or storage,
		# that wins, and the loop below keeps out of the way while the player runs.
		if set_adb_mode; then
			start_adbd
			log "adb set at boot: functions=$(cat $GADGET/functions 2>/dev/null) adbd=$(adbd_pid)"
		else
			log "could not set the gadget to adb"
		fi
	fi

	while :; do
		if ! adb_wanted || player_running; then
			sleep "$PERIOD"
			continue
		fi
		if [ "$(cat "$GADGET/functions" 2>/dev/null)" != "adb" ] || ! adbd_pid > /dev/null; then
			if set_adb_mode; then
				start_adbd
				log "adb restored (no player): functions=$(cat $GADGET/functions 2>/dev/null) adbd=$(adbd_pid)"
			else
				log "could not set the gadget to adb"
			fi
		fi
		sleep "$PERIOD"
	done
}

case "$1" in
start) watchdog & ;;
stop) ;;
esac

exit 0
