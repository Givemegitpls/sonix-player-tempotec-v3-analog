 struct avdtp;
 struct avdtp_server;
+/*
+ * The receive MTU announced for AVDTP channels, in bytes. An L2CAP
+ * configuration that carries no MTU option means the L2CAP default (672), and
+ * a phone feeding an LDAC stream hands its encoder that value minus the media
+ * header -- 660 -- which the encoder refuses: LDAC needs 679 and up
+ * (LDACBT_ERR_ILL_MTU_SIZE) and stops the stream before a single packet.
+ * 1024 is what a phone announces for its own receive side.
+ */
+#define AVDTP_TRANSPORT_IMTU 1024
+
 struct avdtp_stream;
 struct avdtp_local_sep;
 struct avdtp_remote_sep;
