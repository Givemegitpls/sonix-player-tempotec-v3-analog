# The V3 Analog port's own packer: the stock firmware it starts from, the trees
# it works in and the image it writes. The assets and the scripts next to them
# are the sources; these are the outputs, and the image is tens of megabytes.
sonix-packer/v3_analog_original.upt
sonix-packer/build/
sonix-packer/out/

# The V3 Analog port: the simulator's own resource tree (fonts and languages,
# the same files sonix-player/assets/ carries), the pseudo-sysroot built to
# cross-compile the Bluetooth userland, and the packages and tarballs it is
# assembled from.
sonix-player/usr/
sysroot/
*.deb
*.tar.*

# The bluealsa rebuild inputs (see AGENTS.md). The patches, .pc files and READMEs belong
# in git; the extracted trees, sysroots and libraries pulled off the device do not.
bt-src/build/
bt-src/sysroot/
bt-src/debs/
bt-src/libs/
bt-src/third-party/
bt-src/out/
bt-src/src/bluez-alsa-4.0.0/
bt-src/src/bluez-alsa-4.2.0/
bt-src/src/bluez-alsa-4.0.0.patched/

# The kernel is a clone of an upstream tree; what matters is saved under patch/.
kernel-src/

# Backups the tools make next to the files they replace (bluealsa, the ALSA plugin).
*.prev

# Python caches from the tools in patch/ and tools/.
__pycache__/

# The packer's kernel slot: the kernel to install instead of the stock one, put
# there by hand for a kernel-only image (patch/v3-kernel/FLASHING.md). A build
# output, empty in a fresh clone -- and it must stay empty unless a kernel is
# being tested, since the packer installs whatever it finds here.
sonix-packer/kernel/UIMAGE.BIN
