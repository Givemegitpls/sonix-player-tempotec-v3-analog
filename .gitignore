# The V3 Analog port: the simulator's own resource tree (fonts and languages,
# the same files sonix-player/assets/ carries), the pseudo-sysroot built to
# cross-compile the Bluetooth userland, and the packages and tarballs it is
# assembled from.
sonix-player/usr/
sysroot/
*.deb
*.tar.*
